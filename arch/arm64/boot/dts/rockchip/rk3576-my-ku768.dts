/dts-v1/;

#include "rk3576.dtsi"
#include "rk3576-my-base.dtsi"

/ {
	model = "TL3576-Based Board";
	compatible = "tronlong,tl3576-evm", "rockchip,rk3576";

	aliases {
		ethernet0 = &gmac1;
		ethernet1 = &gmac0;
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		//BT,reset_gpio = <&xl8574t 7 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_gpios>;
		WIFI,poweren_gpio = <&gpio2 RK_PD7 GPIO_ACTIVE_HIGH>;
		WIFI,host_wake_irq = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		pwms = <&pwm0_2ch_0 0 50000 0>;
		cooling-levels = <0 50 100 150 200 255>;
		rockchip,temp-trips = <25000   5>;
	};

	leds {
		status = "okay";
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&som_led0 &som_led1 &user_led0 &user_led1>;

		som_led0 {
			label = "heartbeat";
			gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};

		som_led1 {
			label = "lway-led";
			gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "default-on";
			default-state = "off";
		};

		user_led0 {
			label = "wifi_led";
			gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "default-on";
			default-state = "off";
		};

		user_led1 {
			label = "hway-led";
			gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "default-on";
			default-state = "off";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <&user_key0>;

		user_key0 {
			label = "user-key0";
			linux,code = <KEY_PROG2>;
			gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_LOW>;
			debounce-interval = <50>;
		};
	};
};

&gmac0 {
	phy-mode = "rgmii";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio3 RK_PD6 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 10000 50000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth0m1_tx_bus2
				&eth0m1_rx_bus2
				&eth0m1_rgmii_clk
				&eth0m1_rgmii_bus>;

	tx_delay = <0x30>;
	rx_delay = <0x20>;

	phy-handle = <&ksz9896_phy0>;
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};

&i2c1 {
	status = "okay";
};

&i2c3 {
	pinctrl-0 = <&i2c3m2_xfer>;
	status = "okay";
};

&i2c4 {
	pinctrl-0 = <&i2c4m3_xfer>;
	status = "okay";
};

&i2c7 {
	pinctrl-0 = <&i2c7m1_xfer>;
	status = "okay";

	i2c_ksz9896: ksz9896@5f {
		compatible = "microchip,ksz9896";
		reg = <0x5f>;
		reset-gpio = <&gpio3 RK_PD6 GPIO_ACTIVE_LOW>;
		phy-mode = "rgmii";
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				label = "lan1";
			};
			port@1 {
				reg = <1>;
				label = "lan2";
			};
			port@2 {
				reg = <2>;
				label = "lan3";
			};
			port@3 {
				reg = <3>;
				label = "lan4";
			};
			port@4 {
				reg = <4>;
				label = "lan5";
			};
			ksz9896_phy0: port@5 {
				reg = <5>;
				label = "cpu";
				ethernet = <&gmac0>;
				phy-mode = "rgmii";
				fixed-link {
					speed = <1000>;
					full-duplex;
					pause;
				};
			};
		};
	};
};

&i2c9 {
	pinctrl-0 = <&i2c9m3_xfer>;
	status = "okay";
};

&spi0 {
	compatible = "rockchip,spi-slave";
	status = "okay";
	max-freq = <10000000>;
	pinctrl-0 = <&spi0m0_clk &spi0m0_miso &spi0m0_mosi &spi0m0_csn0>;
	#address-cells = <1>;
	#size-cells = <0>;
	slave@0 {
		compatible = "rockchip,spidev";
		spi-max-frequency = <10000000>;
		reg = <0>;
		spi-msb-first;
		status = "okay";
	};
};

&spi1 {
	status = "okay";
	max-freq = <10000000>;
	pinctrl-0 = <&spi1m0_clk &spi1m0_mosi &spi1m0_cs0 &spi1m0_cs1>;
	spi_test@0 {
		compatible = "rockchip,spidev";
		spi-max-frequency = <10000000>;
		id = <0>;
		reg = <0>;
		spi-msb-first;
	};
	spi_test@1 {
		compatible = "rockchip,spidev";
		spi-max-frequency = <10000000>;
		id = <1>;
		reg = <1>;
		spi-msb-first;
	};
};

&spi2 {
	pinctrl-0 = <&spi2m1_csn0 &spi2m1_csn1 &spi2m1_pins>;
	status = "okay";
};

&spi3 {
	compatible = "rockchip,spi-slave";
	status = "okay";
	max-freq = <10000000>;
	pinctrl-0 = <&spi3m2_clk &spi3m2_miso &spi3m2_mosi &spi3m2_csn0>;
	#address-cells = <1>;
	#size-cells = <0>;
	slave@0 {
		compatible = "rockchip,spidev";
		spi-max-frequency = <10000000>;
		reg = <0>;
		spi-msb-first;
		status = "okay";
	};
};

&spi4 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&uart2 {
	pinctrl-0 = <&uart2m1_xfer>;
	status = "okay";
};

&uart5 {
	pinctrl-0 = <&uart5m1_xfer>;
	status = "okay";
};

&uart8 {
	pinctrl-0 = <&uart8m2_xfer>;
	status = "okay";
};

&uart9 {
	pinctrl-0 = <&uart9m1_xfer &uart9m1_ctsn &uart9m1_rtsn>;
	status = "okay";
};

&uart10 {
	status = "okay";
};

&uart11 {
	status = "okay";
};

&pwm2_8ch_6 {
	status = "okay";
	pinctrl-0 = <&pwm2m2_ch6>;
};

&pwm0_2ch_0 {
	status = "okay";
	pinctrl-0 = <&pwm0m0_ch0>;
};

&pinctrl {
	spi0 {
		spi0m0_clk: spi0m0-clk {
			rockchip,pins = <0 RK_PC7 11 &pcfg_pull_none>;
		};
		spi0m0_miso: spi0m0-miso {
			rockchip,pins = <0 RK_PD1 11 &pcfg_pull_none>;
		};
		spi0m0_mosi: spi0m0-mosi {
			rockchip,pins = <0 RK_PD0 11 &pcfg_pull_none>;
		};
		spi0m0_csn0: spi0m0-csn0 {
			rockchip,pins = <0 RK_PC6 11 &pcfg_pull_none>;
		};
	};

	spi1 {
		spi1m0_clk: spi1m0-clk {
			rockchip,pins = <1 RK_PB4 11 &pcfg_pull_none>;
		};
		spi1m0_mosi: spi1m0-mosi {
			rockchip,pins = <1 RK_PB5 11 &pcfg_pull_none>;
		};
		spi1m0_cs0: spi1m0-cs0 {
			rockchip,pins = <1 RK_PB7 11 &pcfg_pull_none>;
		};
		spi1m0_cs1: spi1m0-cs1 {
			rockchip,pins = <1 RK_PC0 11 &pcfg_pull_none>;
		};
	};

	spi3 {
		spi3m2_clk: spi3m2-clk {
			rockchip,pins = <4 RK_PA7 9 &pcfg_pull_none>;
		};
		spi3m2_mosi: spi3m2-mosi {
			rockchip,pins = <4 RK_PA4 9 &pcfg_pull_none>;
		};
		spi3m2_miso: spi3m2-miso {
			rockchip,pins = <4 RK_PA6 9 &pcfg_pull_none>;
		};
		spi3m2_csn0: spi3m2-csn0 {
			rockchip,pins = <4 RK_PA3 9 &pcfg_pull_none>;
		};
	};

	leds {
		som_led0: som-led0 {
			rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		som_led1: sim-led1 {
			rockchip,pins = <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		user_led0: user-led0 {
			rockchip,pins = <3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		user_led1: user-led1 {
			rockchip,pins = <3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	keys {
		user_key0: user-key0 {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	usb {
		usbc0_int: usbc0-int {
			rockchip,pins = <4 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	wireless-wlan {
		wifi_gpios: wifi-gpios {
			rockchip,pins = <2 RK_PD7 RK_FUNC_GPIO &pcfg_pull_none>,
							<3 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
